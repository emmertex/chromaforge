  "shots": [
    {
      "name": "library",
      "steps": [
        {
          "method": "engine.execute",
          "params": {
            "command": "module.library"
          }
        },
        {
          "method": "engine.execute",
          "params": {
            "command": "view.squareGrid"
          }
        },
        {
          "method": "ui.set",
          "params": {
            "leftPanel": true,
            "thumbSize": 150
          }
        }
      ]
    },
    {
      "name": "develop",
      "steps": [
        {
          "method": "engine.execute",
          "params": {
            "command": "library.select",
            "params": {
              "ids": [
                1
              ]
            }
          }
        },
        {
          "method": "engine.execute",
          "params": {
            "command": "module.develop"
          }
        },
        {
          "method": "engine.execute",
          "params": {
            "command": "develop.set",
            "params": {
              "values": {
                "light.highlights": -55,
                "light.shadows": 35,
                "color.vibrance": 25,
                "effects.clarity": 15
              }
            }
          }
        }
      ]
    },
    {
      "name": "mask-1-open",
      "steps": [
        {
          "method": "ui.clickWidget",
          "params": {
            "id": "$masks"
          }
        }
      ]
    },
    {
      "name": "mask-2-linear",
      "steps": [
        {
          "method": "ui.clickWidget",
          "params": {
            "id": "maskNew:linear"
          }
        },
        {
          "method": "ui.pointer",
          "params": {
            "events": [
              {
                "kind": "down",
                "x": 0.5,
                "y": 0.02
              },
              {
                "kind": "drag",
                "x": 0.5,
                "y": 0.25
              },
              {
                "kind": "drag",
                "x": 0.5,
                "y": 0.45
              },
              {
                "kind": "up",
                "x": 0.5,
                "y": 0.45
              }
            ]
          }
        }
      ]
    },
    {
      "name": "mask-3-adjust",
      "steps": [
        {
          "method": "engine.execute",
          "params": {
            "command": "mask.adjust",
            "params": {
              "values": {
                "exposure": -0.6,
                "temp": 25,
                "saturation": 20,
                "dehaze": 20
              }
            }
          }
        }
      ]
    },
    {
      "name": "mask-4-radial",
      "steps": [
        {
          "method": "ui.clickWidget",
          "params": {
            "id": "maskNew:radial"
          }
        },
        {
          "method": "ui.pointer",
          "params": {
            "events": [
              {
                "kind": "down",
                "x": 0.62,
                "y": 0.4
              },
              {
                "kind": "drag",
                "x": 0.7,
                "y": 0.46
              },
              {
                "kind": "drag",
                "x": 0.8,
                "y": 0.52
              },
              {
                "kind": "up",
                "x": 0.8,
                "y": 0.52
              }
            ]
          }
        },
        {
          "method": "engine.execute",
          "params": {
            "command": "mask.adjust",
            "params": {
              "values": {
                "exposure": 0.5,
                "temp": 40,
                "saturation": 15
              }
            }
          }
        }
      ]
    },
    {
